# ==============================================================================
# BLOODBRIDGE Nepal — Environment Configuration Template
# Connecting Lives, One Donation at a Time.
# ==============================================================================

# Node Environment & Network
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# PostgreSQL Database Connection (Production Managed Database)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodbridge_db?schema=public"

# Authentication & Cryptographic Secrets
JWT_ACCESS_SECRET="your-256-bit-access-secret-min-32-chars-random-string"
JWT_REFRESH_SECRET="your-256-bit-refresh-secret-min-32-chars-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Client-Side Application Settings (Vite Prefix)
VITE_API_BASE_URL="/api"
VITE_NEPAL_DEFAULT_LAT="28.0000"
VITE_NEPAL_DEFAULT_LNG="84.2000"
VITE_ENABLE_INTERACTIVE_MAP="true"

# Transactional Email Gateway (Optional - Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@bloodbridge.np"

# Nepal SMS Gateway (Optional - Sparrow SMS / Telco Webhook)
SPARROW_SMS_TOKEN=""
SPARROW_SMS_FROM="BloodBridge"

# Platform Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=25
CORS_ORIGIN="http://localhost:3000"
