# BLOODBRIDGE Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String (Points to local PostgreSQL or Cloud SQL / Neon / Supabase instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodbridge_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="bloodbridge_nepal_jwt_access_super_secret_key_2026_x99!"
JWT_REFRESH_SECRET="bloodbridge_nepal_jwt_refresh_super_secret_key_2026_z11!"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=30
